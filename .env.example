# Dummy values only. Copy to .env locally; never commit real credentials.
# PR-01 skeletons start without provider credentials and report 503 on /ready.

# Browser: public URLs and publishable keys only
VITE_API_BASE_URL=/v1
VITE_WS_BASE_URL=ws://localhost:4000/v1/live
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_GOOGLE_MAPS_BROWSER_KEY=replace-with-origin-restricted-browser-key

# Runtime/network
PORT=4000
CORE_JOBS_STATUS_PORT=4001
MEDIA_STATUS_PORT=4200
APP_ORIGIN=http://localhost:4175
ALLOWED_ORIGINS=http://localhost:4175
LOG_LEVEL=info

# Core database/auth: both URLs must point to hosted Supabase Postgres.
# For this hackathon, the same Supabase connection may be used for both values;
# a dedicated runtime login can be configured later without changing the app.
CORE_DATABASE_URL=postgresql://postgres.project-ref:replace-me@your-project.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.project-ref:replace-me@your-project.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-key
SUPABASE_JWT_ISSUER=https://example-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Separate server-to-server credentials
CORE_INTERNAL_URL=http://localhost:4000
TRIPPY_SERVICE_TOKEN=replace-with-trippy-only-token
MEDIA_SERVICE_TOKEN=replace-with-media-only-token
RUN_CAPABILITY_SECRET=replace-with-random-server-only-secret

# Agent/provider configuration; verify actual accessible model IDs before enabling
TRIPPY_SERVICE_URL=http://localhost:4100
TRIPPY_CORE_API_URL=http://localhost:4000
TRIPPY_PROVIDER=openrouter
TRIPPY_MODEL=stealth/space-bunny-alpha
OPENROUTER_API_KEY=replace-with-openrouter-key
FIREWORKS_API_KEY=replace-with-fireworks-key
GEMINI_API_KEY=replace-with-server-only-key
GEMINI_TEXT_MODEL=replace-with-verified-model-id
GEMINI_LIVE_MODEL=replace-with-verified-live-model-id
GOOGLE_MAPS_SERVER_KEY=replace-with-server-restricted-key

# Private contacts and Media
CONTACT_ENCRYPTION_KEY=replace-with-32-byte-key
CONTACT_KEY_VERSION=1
YUNET_MODEL_PATH=/models/yunet.onnx
SFACE_MODEL_PATH=/models/sface.onnx
FACE_MATCH_THRESHOLD=replace-after-consented-measurement
MEDIA_MAX_UPLOAD_BYTES=20000000
MEDIA_MAX_PIXELS=40000000
MEDIA_WORKER_CONCURRENCY=1

# Jobs/decisions and optional notifications
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=5
PROPOSAL_DEFAULT_TTL_SECONDS=86400
NOTIFICATION_PROVIDER_ENABLED=false
