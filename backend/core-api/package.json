{
  "name": "@convia/core-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "dev:jobs": "node --env-file-if-exists=../../.env --import tsx --watch src/jobs/worker.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/db/seed.ts",
    "db:conformance": "node --env-file-if-exists=../../.env --import tsx src/db/conformance.ts",
    "test:real-auth": "node --env-file-if-exists=../../.env --import tsx src/auth/real-users.smoke.ts",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx --test src/db/domain.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@convia/contracts": "workspace:*",
    "@supabase/supabase-js": "2.117.1",
    "decimal.js": "10.6.0",
    "fastify": "5.6.1",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
